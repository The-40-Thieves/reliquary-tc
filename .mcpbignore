# .mcpbignore — prunes the staged tree before it is packed into the .mcpb (gitignore syntax).
#
# This file does NOT decide what the bundle ships. scripts/bundle-mcpb.ts packs from a throwaway
# staging directory, and scripts/lib/mcpb-staging.mjs stages an allow-list (STAGED_REPO_PATHS:
# LICENSE, NOTICE, README.md, package.json, packages/server/dist and the three files beside it),
# writes mcpb/manifest.json's content as the staging root's manifest.json, and assembles the
# bundle's own node_modules. A repo file that is not on that list cannot reach the bundle, so a new
# tracked file needs no line here. To ship something new, add it to STAGED_REPO_PATHS.
#
# What is left for this file: this file itself, and file kinds that can sit inside the staged
# directories without being part of the runtime. node_modules is deliberately NOT ignored: the
# staged one holds only what the server reaches by bare specifier at run time.

.mcpbignore

# TypeScript sources and tests — the bundle ships built JavaScript
**/*.ts
!**/*.d.ts
**/*.test.*
**/__snapshots__/

# Docs (only the root README is kept, for the extension card)
*.md
!/README.md

# Local clutter and build output
.DS_Store
*.mcpb
